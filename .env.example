# Local development defaults. For Supabase, use the pooled port 6543 URL at runtime
# and the direct port 5432 URL for migrations.
DATABASE_URL="postgresql://eevents:eevents_dev_only@localhost:55432/eevents?schema=public"
DIRECT_URL="postgresql://eevents:eevents_dev_only@localhost:55432/eevents?schema=public"

# Supabase Storage. Keep the service-role key server-side; never expose it publicly.
# Apply supabase/setup-storage.sql and supabase/setup-event-media.sql in the SQL editor.
# event-media is a separate private WebP bucket. It does not replace certificates.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-only-service-role-key"

# Required by `pnpm db:seed`. Use a unique, strong password outside local development.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Canonical application origin used by signed ticket and certificate upload links.
APP_ORIGIN="http://localhost:3000"
# Generate a unique 32-byte minimum secret shared with the certificate-upload
# Supabase Edge Function using: openssl rand -base64 32
CHECKIN_SIGNING_SECRET="replace-with-a-random-32-byte-or-longer-secret"
